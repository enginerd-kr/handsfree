{
  "orchestration": {
    "provider": "local",
    "local": {
      "baseURL": "http://localhost:1234/v1",
      "model": "google/gemma-3-12b",
      "temperature": 0.1
    },
    "acp": {
      "agent": "claude",
      "model": "haiku",
      "timeoutMs": 120000
    },
    "maxHistoryMessages": 30
  },

  "proxy": {},

  "agents": {
    "claude": { "command": "npx", "args": ["-y", "@agentclientprotocol/claude-agent-acp"] },
    "gemini": { "command": "gemini", "args": ["--acp"] },
    "codex": { "command": "npx", "args": ["-y", "@agentclientprotocol/codex-acp"] }
  },

  "roles": {
    "claude": "general coding agent, strong at multi-file edits",
    "gemini": "fast, good at bulk text and single-file work",
    "codex": "methodical coding agent, good at tests and refactors"
  },

  "capabilities": {
    "readTextFile": true,
    "writeTextFile": true,
    "terminal": true,
    "elicitation": true
  },

  "policy": {
    "workspaceOnly": true,
    "fs": { "read": "allow", "write": "allow", "outside": "deny", "followSymlinks": false },
    "exec": {
      "enabled": true,
      "mode": "allowlist",
      "otherwise": "ask",
      "shellOperators": "ask",
      "timeoutMs": 120000,
      "outputByteLimit": 262144,
      "env": ["PATH", "HOME", "LANG", "TERM", "TMPDIR"]
    },
    "escalation": ["user"],
    "decisionTimeoutMs": 120000
  },

  "limits": {
    "handshakeTimeoutMs": 90000,
    "turnTimeoutMs": 600000,
    "idleTimeoutMs": 180000,
    "cancelGraceMs": 10000,
    "maxDelegationsPerTurn": 3,
    "maxPlanSteps": 6,
    "maxResultChars": 4000,
    "rebriefEveryTasks": 8
  }
}
