{
  "orchestration": {
    "provider": "local",
    "local": {
      "baseURL": "http://localhost:1234/v1",
      "model": "google/gemma-3-12b",
      "temperature": 0.1
    },
    "acp": {
      "agent": "claude",
      "timeoutMs": 120000
    },
    "maxHistoryMessages": 30
  },

  "proxy": {},

  "agents": {
    "claude": {
      "command": "npx",
      "args": ["-y", "@zed-industries/claude-code-acp"],
      "note": "general coding agent, strong at multi-file edits"
    },
    "gemini": {
      "command": "gemini",
      "args": ["--experimental-acp", "-m", "gemini-3.5-flash"],
      "note": "fast, good at bulk text and single-file work"
    },
    "codex": {
      "enabled": false,
      "command": "npx",
      "args": ["-y", "@zed-industries/codex-acp"],
      "note": "methodical coding agent, good at tests and refactors"
    }
  },

  "capabilities": {
    "readTextFile": true,
    "writeTextFile": true,
    "terminal": false,
    "elicitation": false
  },

  "policy": {
    "workspaceOnly": true,
    "fs": { "read": "allow", "write": "allow", "outside": "deny", "followSymlinks": false },
    "exec": {
      "enabled": false,
      "mode": "allowlist",
      "allow": ["git status", "git diff", "git log", "ls", "cat", "pnpm test", "pnpm build"],
      "shellOperators": "deny",
      "timeoutMs": 120000,
      "outputByteLimit": 262144,
      "env": ["PATH", "HOME", "LANG", "TERM", "TMPDIR"]
    },
    "escalation": ["user"],
    "decisionTimeoutMs": 120000
  },

  "limits": {
    "handshakeTimeoutMs": 90000,
    "turnTimeoutMs": 600000,
    "idleTimeoutMs": 180000,
    "cancelGraceMs": 10000,
    "maxDelegationsPerTurn": 3,
    "maxPlanSteps": 6,
    "maxResultChars": 4000
  }
}
