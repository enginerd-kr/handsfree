{
  "orchestration": {
    "provider": "local",
    "local": {
      "baseURL": "http://localhost:1234/v1",
      "model": "google/gemma-3-4b",
      "temperature": 0.1
    },
    "acp": {
      "agent": "claude",
      "model": "haiku"
    },
    "relayAnswers": false
  },
  "env": {},
  "agents": {
    "claude": {
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/claude-agent-acp"
      ]
    },
    "gemini": {
      "command": "gemini",
      "args": [
        "--acp"
      ]
    },
    "codex": {
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/codex-acp"
      ],
      "nativeTools": "allow"
    }
  },
  "roles": {
    "claude": "general coding agent, strong at multi-file edits",
    "gemini": "fast, good at bulk text and single-file work",
    "codex": "methodical coding agent, good at tests and refactors"
  },
  "capabilities": {
    "readTextFile": true,
    "writeTextFile": true,
    "terminal": true,
    "elicitation": true
  },
  "execution": {
    "routing": "auto"
  },
  "prices": {}
}
