{
  "orchestration": {
    "provider": "local",
    "local": {
      "baseURL": "http://localhost:1234/v1",
      "model": "google/gemma-3-4b",
      "temperature": 0.1
    },
    "acp": {
      "agent": "claude",
      "model": "haiku",
      "timeoutMs": 120000
    },
    "maxHistoryMessages": 30,
    "contextBudgetTokens": 8000,
    "relayAnswers": false,
    "maxOutputTokens": 768,
    "maxRepairAttempts": 2
  },
  "env": {},
  "agents": {
    "claude": {
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/claude-agent-acp"
      ]
    },
    "gemini": {
      "command": "gemini",
      "args": [
        "--acp"
      ]
    },
    "codex": {
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/codex-acp"
      ],
      "nativeTools": "allow"
    }
  },
  "roles": {
    "claude": "general coding agent, strong at multi-file edits",
    "gemini": "fast, good at bulk text and single-file work",
    "codex": "methodical coding agent, good at tests and refactors"
  },
  "capabilities": {
    "readTextFile": true,
    "writeTextFile": true,
    "terminal": true,
    "elicitation": true
  },
  "policy": {
    "workspaceOnly": true,
    "fs": {
      "read": "allow",
      "write": "allow",
      "outside": "deny",
      "followSymlinks": false
    },
    "exec": {
      "enabled": true,
      "mode": "allowlist",
      "otherwise": "ask",
      "shellOperators": "ask",
      "timeoutMs": 120000,
      "outputByteLimit": 65536,
      "env": [
        "PATH",
        "HOME",
        "LANG",
        "TERM",
        "TMPDIR"
      ]
    },
    "escalation": [
      "user"
    ],
    "decisionTimeoutMs": 120000
  },
  "limits": {
    "handshakeTimeoutMs": 90000,
    "turnTimeoutMs": 600000,
    "idleTimeoutMs": 180000,
    "cancelGraceMs": 10000,
    "maxDelegationsPerTurn": 3,
    "maxPlanSteps": 6,
    "maxResultChars": 1200,
    "handoffBudgetChars": 1600,
    "reportSummaryChars": 300,
    "rebriefEveryTasks": 8
  },
  "budget": {
    "maxTokens": 200000,
    "maxFrontierTokens": 150000,
    "maxTaskTokens": 128000,
    "estimatedTaskTokens": 4096,
    "maxTaskOutputTokens": 4096
  },
  "execution": {
    "maxParallel": 2,
    "maxBatchTasks": 16,
    "maxCandidates": 3,
    "rotateContextRatio": 0.85,
    "routing": "auto",
    "routingContextTokens": 2048
  },
  "prices": {}
}
