# E2e runs against a REAL OpenAI-compatible endpoint and REAL frontier CLIs.
# Start LM Studio (or any OpenAI-compatible server) and set:
HANDSFREE_LLM_BASE_URL=http://localhost:1234/v1
HANDSFREE_LLM_MODEL=google/gemma-3-12b
# HANDSFREE_LLM_API_KEY=not-needed

# The claude / gemini / codex CLIs must be installed and authenticated
# (they inherit your local login state; gemini reads ~/.gemini/.env).
